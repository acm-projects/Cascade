# === trends feature ===

# YouTube Data API v3 key (Google Cloud Console -> APIs & Services -> Credentials)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Set to true to guarantee zero Anthropic spend: any video without a cached tag
# result will fail loudly instead of calling the API. Useful while testing
# everything else (ffmpeg, yt-dlp, the frontend) for free.
ANTHROPIC_CALLS_DISABLED=false

# === shared ===

# Origin the frontend is served from, for CORS (default matches `uvicorn` on port 8000)
FRONTEND_ORIGIN=http://localhost:8000

# clips, video_search, and settings features need no API keys - everything
# they use (moviepy, faster-whisper, sentence-transformers, ffmpeg) runs locally.
