# === which AI model runs everything =====================================================
# ONE setting picks the provider for the clip agent, the transcript summaries and the Trends
# tab: anthropic (default) or openai. The model is fixed in code per provider (Claude Haiku 5.5
# / gpt-6-luna) - there are no model names to edit here. Put the matching key below.
# Changes apply to the next job; no server restart needed.
LLM_PROVIDER=anthropic

# Anthropic API key (https://console.anthropic.com/settings/keys) - used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API key (https://platform.openai.com/api-keys) - used when LLM_PROVIDER=openai.
# Before switching to openai, run the live check once:  cd backend && python scripts/check_openai.py
OPENAI_API_KEY=your_openai_api_key_here

# === trends feature ===

# YouTube Data API v3 key (Google Cloud Console -> APIs & Services -> Credentials)
YOUTUBE_API_KEY=your_youtube_api_key_here

# === agent feature (clip-finding agent) ===

# Transcription: Deepgram (default) or local Whisper. There is NO automatic fallback
# from Deepgram to Whisper - Whisper on a long video can take hours on a CPU - so
# switching is always your explicit choice.
TRANSCRIPTION_PROVIDER=deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# === shared ===

# Origin the frontend is served from, for CORS (default matches `uvicorn` on port 8000)
FRONTEND_ORIGIN=http://localhost:8000

# Local visual/speech search uses local models and FFmpeg.
# The integrated website also requires Clerk (the AI model key is set at the top of this file).
# See README_C.md and INTEGRATION.md for setup and optional S3 storage.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
S3_BUCKET_NAME=
