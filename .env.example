# === which AI model runs everything =====================================================
# ONE setting picks the provider for the clip agent, the transcript summaries and the Trends
# tab: anthropic (default) or openai. The model is fixed in code per provider (Claude Haiku 5.5
# / gpt-6-luna) - there are no model names to edit here. Put the matching key below.
# Changes apply to the next job; no server restart needed.
LLM_PROVIDER=anthropic

# Anthropic API key (https://console.anthropic.com/settings/keys) - used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API key (https://platform.openai.com/api-keys) - used when LLM_PROVIDER=openai.
# Before switching to openai, run the live check once:  cd backend && python scripts/check_openai.py
OPENAI_API_KEY=your_openai_api_key_here

# === trends feature ===

# YouTube Data API v3 key (Google Cloud Console -> APIs & Services -> Credentials)
YOUTUBE_API_KEY=your_youtube_api_key_here

# === speech-to-text (Deepgram) ===
# Deepgram is the only transcription path: the clip agent, speech/visual search, caption styles and
# the Trends tab all call it. There is no local Whisper. About $0.26 per audio hour; without this
# key those features stop with a clear message.
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# === shared ===

# Origin the frontend is served from, for CORS (default matches `uvicorn` on port 8000)
FRONTEND_ORIGIN=http://localhost:8000

# The website requires Clerk sign-in (the AI model key is set at the top of this file).
# Clerk keys: https://dashboard.clerk.com -> API Keys
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# === clip storage ===
# Clips are stored locally unless S3 is configured. See README_C.md and INTEGRATION.md.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
S3_BUCKET_NAME=

# === database (used by the separate root app.py service, not by the website in app1.py) ===
DATABASE_URL=

# === optional tuning (defaults are fine; remove the leading # to change) ===
# local | s3 | auto (default auto: S3 when configured, otherwise local)
# CASCADE_STORAGE=auto
# Stop a job after this many seconds. Unset means no time limit.
# CASCADE_JOB_TIMEOUT=
# Seconds allowed for each FFmpeg command (default 300)
# CASCADE_FFMPEG_TIMEOUT=300
# Set to 0 to skip loading the CLIP/MiniLM search models at server start (they hold ~700 MB of RAM)
# CASCADE_WARM_MODELS=1

# Editor authentication and optional OpenAI chat override:
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
CASCADE_STORAGE=local
# OPENAI_EDITOR_MODEL=
# OPENAI_SCENE_MODEL=gpt-5.4-mini
# CASCADE_EDITOR_FFMPEG=/path/to/ffmpeg

# Server-only stock footage provider:
PEXELS_API_KEY=
