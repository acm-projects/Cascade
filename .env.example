# === trends feature ===

# YouTube Data API v3 key (Google Cloud Console -> APIs & Services -> Credentials)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Set to true to guarantee zero Anthropic spend: any video without a cached tag
# result will fail loudly instead of calling the API. Useful while testing
# everything else (ffmpeg, yt-dlp, the frontend) for free.
ANTHROPIC_CALLS_DISABLED=false

# Model that tags videos on the Trends tab (default Haiku 5.5; gpt-6-luna also works).
TAGGING_MODEL=claude-haiku-5-5

# === agent feature (clip-finding agent) ===

# --- Which LLM does what -------------------------------------------------------------
# Each model id picks its own provider: claude-* -> Anthropic (default), gpt-* -> OpenAI.
# They can differ (e.g. Claude for summaries, Luna for the agent). Keys are read when a job
# starts, so a new key applies to the next run without a restart.
#
# OpenAI is off until you add a key. After adding it, run the live check ONCE before switching:
#     cd backend && python scripts/check_openai.py
# and only change a model to gpt-6-luna if it prints "OVERALL: PASS".
OPENAI_API_KEY=your_openai_api_key_here
# Set to true to guarantee zero OpenAI spend (like ANTHROPIC_CALLS_DISABLED above).
OPENAI_CALLS_DISABLED=false
# OpenAI only: reasoning effort for the agent loop (none|low|medium|high|xhigh|max), and how
# frames returned by a tool are sent: user_message (default, safe) or array (set by the check).
AGENT_REASONING_EFFORT=medium
OPENAI_IMAGE_TOOL_OUTPUT=user_message
# Only for model ids that are neither claude-* nor gpt-* (rare): which provider to assume.
# LLM_PROVIDER=anthropic

# Model driving the agent loop. Default is Claude Haiku 5.5; gpt-6-luna switches it to OpenAI.
AGENT_MODEL=claude-haiku-5-5

# Model that writes the per-chunk transcript summaries for long videos (podcasts) - Claude or OpenAI.
# Summaries are cached per video, so this is spent once per video.
SUMMARY_MODEL=claude-haiku-5-5

# Transcription: Deepgram (default) or local Whisper. There is NO automatic fallback
# from Deepgram to Whisper - Whisper on a long video can take hours on a CPU - so
# switching is always your explicit choice.
TRANSCRIPTION_PROVIDER=deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key_here
# Set to true to guarantee zero Deepgram spend (uncached videos then fail loudly).
DEEPGRAM_CALLS_DISABLED=false

# === shared ===

# Origin the frontend is served from, for CORS (default matches `uvicorn` on port 8000)
FRONTEND_ORIGIN=http://localhost:8000

# clips, video_search, and settings features need no API keys - everything
# they use (moviepy, faster-whisper, sentence-transformers, ffmpeg) runs locally.
